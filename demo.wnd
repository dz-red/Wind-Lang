file.write("/tmp/wtest.txt", "строка раз")
str.c = file.read("/tmp/wtest.txt")
terminal.paste -> "читаю: {str.c}"
file.append("/tmp/wtest.txt", " + строка два")
str.c2 = file.read("/tmp/wtest.txt")
terminal.paste -> "после append: {str.c2}"
if file.exists("/tmp/wtest.txt")
    terminal.paste -> "файл существует"
end
