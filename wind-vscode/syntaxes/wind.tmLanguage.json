{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wind",
  "scopeName": "source.wnd",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "name": "keyword.control.wnd", "match": "\\b(?:if|else|end|while|repeat|loop|for|in|break|continue|try|catch|throw|return|on)\\b" },
    { "name": "keyword.declaration.wnd", "match": "\\b(?:global|var)\\b" },
    { "name": "keyword.control.import.wnd", "match": "\\b(?:link|use|take|from)\\b" },
    { "name": "support.function.builtin.wnd", "match": "\\b(?:terminal\\.paste|http\\.serve)\\b" },
    { "include": "#expressions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.wnd", "match": "//.*$" },
        { "name": "comment.block.wnd", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.wnd",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.interpolation.wnd",
          "contentName": "meta.embedded.expression.wnd",
          "begin": "\\$\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.wnd" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.wnd" } },
          "patterns": [
            { "include": "#expressions" }
          ]
        },
        { "name": "constant.character.escape.wnd", "match": "\\\\." }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(c\\s*\\.\\s*import)\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(>)",
          "captures": {
            "1": { "name": "keyword.control.import.wnd" },
            "2": { "name": "punctuation.definition.import.begin.wnd" },
            "3": { "name": "entity.name.namespace.wnd" },
            "4": { "name": "punctuation.definition.import.end.wnd" }
          }
        },
        {
          "match": "\\b(func|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.wnd" },
            "2": { "name": "entity.name.function.wnd" }
          }
        },
        {
          "match": "\\b(use|from)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.wnd" },
            "2": { "name": "entity.name.namespace.wnd" }
          }
        }
      ]
    },
    "expressions": {
      "patterns": [
        { "name": "constant.language.boolean.wnd", "match": "\\b(?:true|false)\\b" },
        { "name": "support.function.builtin.wnd", "match": "\\b(?:file\\.(?:read|write|append|exists)|json\\.(?:parse|decode|encode)|http\\.(?:get|post)|time\\.(?:now|clock|sleep)|len|to_str|int|frac|str|bool)(?=\\s*\\()" },
        { "name": "storage.type.wnd", "match": "\\b(?:int|frac|str|bool|list|array|dict|void)\\b" },
        { "name": "entity.name.function.call.wnd", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
        { "name": "constant.numeric.wnd", "match": "\\b\\d+(?:,\\d+)?\\b" },
        { "name": "keyword.operator.wnd", "match": "->|\\.\\.|/%|==|!=|<=|>=|&&|\\|\\||[+*/-]=|[=<>+*/-]" }
      ]
    }
  }
}
